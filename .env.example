# ==========================================================================
# Nation 47 — Checkout próprio. Copie para .env e preencha.
# NUNCA commite o .env com valores reais. No Render, use o painel de env vars.
# ==========================================================================

# --- App ---
PORT=3000
# Em produção o Render injeta RENDER_EXTERNAL_URL automaticamente.
# Sobrescreva só se tiver domínio próprio (ex: https://checkout.nation47.com.br)
APP_URL=http://localhost:3000

# --- Loja / catálogo / moeda ---
CURRENCY=BRL

# --- Promoção "2 pares R$ 149" (centavos) ---
# Elegíveis = produtos com este preço (em centavos). 9900 = R$ 99,00
PROMO_ELIGIBLE_PRICE_CENTS=9900
# Mínimo de unidades elegíveis pra ativar a promo
PROMO_MIN_QTY=2
# Taxa exata = NUM/DEN sobre o total elegível. 4900/19800 = 24,75% (2x99=198 -> 149)
PROMO_NUM=4900
PROMO_DEN=19800
# Rótulo exibido no resumo
PROMO_LABEL=PROMO 2 PARES
# OPCIONAL. Restringe a promo a certos produtos, POR CIMA do filtro de preço:
# pedaços de handle separados por vírgula, e o item entra se o handle contiver
# qualquer um deles. VAZIA = sem restrição (é o caso da Nation, em que o preço
# elegível já identifica o produto sozinho).
# Só faz falta na loja em que produtos DIFERENTES custam o mesmo — na Knife Lab
# as facas avulsas custam os mesmos R$ 149,90 dos kits e cairiam na promoção
# sem querer. Lá vale: PROMO_HANDLES=copo-termico,5-pecas
PROMO_HANDLES=

# --- UmbrellaPag (cash-in PIX) ---
# Auth: header x-api-key com a chave (UUID) + User-Agent UMBRELLAB2B/1.0.
# Sem webhook por conta: a URL de retorno vai por cobrança (postbackUrl).
# Antes de usar uma chave, confira DE QUEM ela é: GET /api/user/sellers devolve
# o commercialName da conta que vai receber o dinheiro.
UMBRELLA_BASE_URL=https://api-gateway.umbrellapag.com/api
UMBRELLA_API_KEY=

# Gateway usado quando ainda não há escolha salva no banco (/admin sobrescreve).
DEFAULT_GATEWAY=umbrella

# --- Solution Payments (cash-in PIX) — opção anterior ---
# Auth: Basic base64("x:" + chave). A chave começa com sk_
SOLUTION_BASE_URL=https://api.solutionpayments.com.br
SOLUTION_API_KEY=

# --- PixGate (cash-in PIX) — fallback ---
PIXGATE_BASE_URL=https://api.pixgate.example.com
PIXGATE_API_KEY=

# --- Shopify (OAuth) ---
SHOPIFY_SHOP=nation-47.myshopify.com
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,write_orders,read_orders
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternativa ao OAuth: token estático shpat_... (se você conseguir gerar)
SHOPIFY_ADMIN_TOKEN=

# --- Facebook ---
# FB_PIXEL_ID é público (pode ficar no código); o token é SEGREDO, só aqui.
FB_PIXEL_ID=1563522885353553
FB_CAPI_TOKEN=
# Opcional: código de teste do Events Manager pra depurar eventos
FB_TEST_EVENT_CODE=

# --- Dev ---
# 1 habilita POST /dev/pay/:orderId pra simular pagamento localmente
DEV_TOOLS=0

# --- UTMify ---
# pixelId da UTMify. E publico (sai no HTML).
UTMIFY_PIXEL_ID=6a68036e9e4969c2b239d1df
# Token de API da UTMify (SEGREDO) - lanca as vendas no painel deles.
UTMIFY_API_TOKEN=

# --- Coreon Pay (cash-in PIX) ---
# Chave publica (X-Api-Key) + secret (X-Api-Secret): as duas sao obrigatorias.
COREON_BASE_URL=https://app.coreonpay.com
COREON_API_KEY=
COREON_API_SECRET=
# Segredo do webhook cadastrado no painel da Coreon (prefixo whsec_).
# Sem ele o postback ainda funciona, mas sem conferencia de assinatura.
COREON_WEBHOOK_SECRET=
# Dominio enviado no campo obrigatorio `domain`. Vazio = usa o dominio do APP_URL.
COREON_DOMAIN=

# Rastreio próprio (RotaSync). A chave da loja começa com rk_ e vai no header
# "Authorization: Bearer <chave>". Sem as duas, a loja não fala com o rastreio.
RASTREIO_BASE_URL=https://rotasync.online
RASTREIO_API_KEY=

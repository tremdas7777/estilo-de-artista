# ========== PÚBLICO (pode commitare em .env no Git/Lovable) ==========
# Project Settings → API no supabase.com
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon...

# Espelho no servidor (Lovable preenche ao conectar Cloud/Supabase)
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_PUBLISHABLE_KEY=eyJ...anon...

# ========== SECRETS (Lovable: More → Cloud → Secrets) ==========
# NÃO coloque service role no Git. No Lovable o prefixo SUPABASE_ é reservado:
# ao CONECTAR seu projeto Supabase, SUPABASE_SERVICE_ROLE_KEY entra sozinho.
# Se não puder conectar, use estes aliases nos Secrets:
#   ESTILO_SB_URL
#   ESTILO_SB_ANON_KEY
#   ESTILO_SB_SERVICE_ROLE_KEY
ADMIN_PASSWORD=sua_senha_do_painel

# Catálogo
LOJA_API_URL=https://estilo-de-artista.vercel.app

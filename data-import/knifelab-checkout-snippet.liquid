{%- comment -%}
  ============================================================================
  CHECKOUT PROPRIO — Knife Lab
  ============================================================================
  Manda o cliente para https://knifelab-checkout.onrender.com em vez do
  checkout da Shopify.

  O QUE ELE PEGA:
    - "Comprar agora"      (.button--primary)  -> vai direto pro checkout
    - "FINALIZAR COMPRA"   (button[name=checkout], na sacola e no mini-carrinho)

  O QUE ELE NAO TOCA, DE PROPOSITO:
    - "Adicionar ao carrinho" (.button--primary-add) -> segue o fluxo normal da
      Shopify: adiciona, abre a gaveta, atualiza o contador. Os dois botoes tem
      a MESMA classe .product-form__add-button, por isso a regra olha
      .button--primary-add para excluir, em vez de casar pelo texto (que muda
      com o idioma).

  COMO INSTALAR:
    1. Admin da loja -> Loja virtual -> Temas -> ... -> Editar codigo
    2. Snippets -> Adicionar um novo snippet -> nome: checkout-proprio
    3. Cole TODO este arquivo e salve
    4. Abra layout/theme.liquid e, logo antes de </body>, acrescente:
         {% render 'checkout-proprio' %}
    5. Salve.

  PARA DESLIGAR: apague a linha do passo 4. A loja volta ao checkout da
  Shopify na hora, sem mais nada para desfazer.
{%- endcomment -%}

<script>
(function () {
  var CHECKOUT = 'https://knifelab-checkout.onrender.com/checkout';

  // Se qualquer coisa aqui falhar, o clique segue o caminho normal da Shopify.
  // Loja parada vende zero; checkout proprio quebrado vende zero e ainda
  // esconde o motivo. Por isso todo caminho tem saida pelo comportamento padrao.
  function irPara(itens) {
    if (!itens.length) return false;
    window.location.href = CHECKOUT + '?items=' + itens.join(',');
    return true;
  }

  // ------------------------------------------------------- "Comprar agora"
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.product-form__add-button');
    if (!btn) return;
    // Deixa passar: este e o botao de CARRINHO, nao o de compra.
    if (btn.classList.contains('button--primary-add')) return;
    if (btn.disabled) return;

    var form = btn.closest('form');
    if (!form) return;
    var campoId = form.querySelector('[name="id"]');
    if (!campoId || !campoId.value) return;   // sem variante escolhida: fluxo normal

    var qtd = 1;
    var campoQtd = form.querySelector('[name="quantity"]');
    if (campoQtd && parseInt(campoQtd.value, 10) > 0) qtd = parseInt(campoQtd.value, 10);

    e.preventDefault();
    e.stopPropagation();
    irPara([campoId.value + ':' + qtd]);
  }, true);

  // -------------------------------------------------- "FINALIZAR COMPRA"
  // Le a sacola pelo /cart.js em vez de ler o DOM: funciona igual na pagina
  // do carrinho e no mini-carrinho, e nao depende do HTML do tema.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('[name="checkout"]');
    if (!btn || btn.disabled) return;

    e.preventDefault();
    e.stopPropagation();

    var rotulo = btn.textContent;
    if (btn.tagName === 'BUTTON') { btn.disabled = true; btn.textContent = 'Aguarde...'; }

    fetch('/cart.js', { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var itens = (cart.items || [])
          .filter(function (i) { return i.id && i.quantity > 0; })
          .map(function (i) { return i.id + ':' + i.quantity; });
        if (!irPara(itens)) throw new Error('sacola vazia');
      })
      .catch(function () {
        // Nao conseguiu ler a sacola: devolve o botao e deixa a Shopify assumir.
        if (btn.tagName === 'BUTTON') { btn.disabled = false; btn.textContent = rotulo; }
        var form = btn.closest('form');
        if (form) form.submit();
      });
  }, true);
})();
</script>
